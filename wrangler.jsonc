{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pypsa-org-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "build",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Static files must never invoke the Worker, to stay under the free plan's request limit.
    "run_worker_first": [
      "/*",
      // Hashed JS and CSS from SvelteKit.
      "!/_app/*",
      // Images: avatars, thumbnails, logos.
      "!/img/*",
      // Gurubase widget loader.
      "!/js/*",
      // Standalone map pages, framed on the homepage.
      "!/explore/*",
      // Prerendered JSON endpoints and the root route's data.
      "!/data/*",
      "!/__data.json",
      "!/favicon.*",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/llms.txt",
      "!/llms-full.txt",
      // Markdown mirrors requested by their own URL.
      "!/*.md",
      "!/events/*.md",
      // Served by not_found_handling.
      "!/404.html",
    ],
  },
  "d1_databases": [
    {
      "binding": "SURVEY_DB",
      "database_name": "pypsa-survey",
      "database_id": "00985fb4-1002-4979-8f4b-8737a29a6150",
      "migrations_dir": "migrations",
    },
  ],
  // 5 survey submissions per IP per minute, the binding stores no IP.
  "ratelimits": [
    { "name": "SURVEY_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  // Required by `wrangler preview` (per-branch previews in Workers Builds). Bindings and vars are
  // not inherited, so previews repeat them. SURVEY_TEST lets previews take responses outside the
  // open window, into the production database, so test rows are told apart by date.
  "previews": {
    "vars": { "SURVEY_TEST": "1" },
    "d1_databases": [
      {
        "binding": "SURVEY_DB",
        "database_name": "pypsa-survey",
        "database_id": "00985fb4-1002-4979-8f4b-8737a29a6150",
        "migrations_dir": "migrations",
      },
    ],
    "ratelimits": [
      {
        "name": "SURVEY_RATE_LIMIT",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
  },
}
