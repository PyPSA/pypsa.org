{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pypsa-org-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "build",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Static files must never invoke the Worker, to stay under the free plan's request limit.
    "run_worker_first": [
      "/*",
      // Hashed JS and CSS from SvelteKit.
      "!/_app/*",
      // Images: avatars, thumbnails, logos.
      "!/img/*",
      // Gurubase widget loader.
      "!/js/*",
      // Standalone map pages, framed on the homepage.
      "!/explore/*",
      // Prerendered JSON endpoints and the root route's data.
      "!/data/*",
      "!/__data.json",
      "!/favicon.*",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/llms.txt",
      "!/llms-full.txt",
      // Markdown mirrors requested by their own URL.
      "!/*.md",
      "!/events/*.md",
      "!/newsletter/*.md",
      // Served by not_found_handling.
      "!/404.html",
    ],
  },
  // Replace the placeholders, since 0 makes the newsletter route answer 500.
  // BREVO_API_KEY and TURNSTILE_SECRET_KEY are secrets set with `wrangler secret put`, never committed.
  "vars": {
    "BREVO_LIST_ID": "0",
    "BREVO_DOI_TEMPLATE_ID": "0",
    "BREVO_DOI_REDIRECT_URL": "https://pypsa.org/newsletter/confirmed",
  },
  // Required by `wrangler preview` (per-branch previews in Workers Builds).
  "previews": {},
}
